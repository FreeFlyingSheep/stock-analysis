# ==============================================================================
# Stock Analysis Application - Environment Variables Template (.env.example)
# ==============================================================================
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your actual configuration values
#
# Security Note:
#   Never commit .env to version control. This template is safe to commit.
#
# Docker Compose Note:
#   When services run inside docker-compose, "localhost" refers to the container
#   itself, NOT the host machine and NOT other services.
#   Inside compose, prefer service names (postgres, redis, minio, nginx, alloy, ...)
#   as hostnames for inter-service communication.
# ==============================================================================


# ==============================================================================
# 1) Primary Datastores for THIS App (Postgres / MinIO / Redis)
# ==============================================================================
# These are used by your application services (migrate/api/worker/mcp/web).
# In docker-compose, your service definitions may override hostnames to service
# names (postgres/minio/redis). Keep these as "127.0.0.1" for local runs.

# ---- PostgreSQL ----
DATABASE_USER=postgres
DATABASE_PASSWORD=CHANGEME_database_password
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_DB=stock_analysis

# ---- MinIO (S3-compatible object storage) ----
MINIO_USER=minioadmin
MINIO_PASSWORD=CHANGEME_minio_password
MINIO_HOST=127.0.0.1
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Only used for local/non-docker runs or documentation reference
MINIO_DATA_DIR=data/minio

# Prefix for buckets created/used by your app
# MinIO bucket names must follow DNS naming conventions (no underscores)
MINIO_BUCKET_PREFIX=stock-analysis-

# Whether to use HTTPS when talking to MinIO (only if your code uses it)
MINIO_SECURE=false

# ---- Redis ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=CHANGEME_redis_password

# Prefix/namespace for Redis keys to avoid collisions
REDIS_PREFIX=stock-analysis


# ==============================================================================
# 2) Backend / API Service Configuration
# ==============================================================================
# These settings control your backend behavior, paths, ports, and logging.

CONFIG_DIR=configs/api/cninfo
RULE_FILE_PATH=configs/rules/scoring_rules_sample.yaml
PROMPTS_DIR=configs/prompts

# Debug mode (do not enable in production)
DEBUG=false

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Optional log file output path (ensure directory exists if used)
LOG_FILE=./logs/app.log

# Backend bind address/port.
# - For docker containers, you typically bind to 0.0.0.0.
# - For local runs, 127.0.0.1 is fine.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Prometheus metrics endpoint port for the API
METRICS_PORT=9464


# ==============================================================================
# 3) Worker Configuration
# ==============================================================================
# Background processing settings.

WORKER_LOG_LEVEL=INFO
WORKER_LOG_FILE=./logs/worker.log

# Number of tasks processed per batch
BATCH_SIZE=2

# Max concurrent tasks. Keep > 2 * BATCH_SIZE as your comment suggests.
MAX_CONCURRENT_TASKS=5

# Prometheus metrics endpoint port for the worker
WORKER_METRICS_PORT=9465


# ==============================================================================
# 4) MCP Configuration
# ==============================================================================
# MCP service settings.

MCP_HOST=127.0.0.1
MCP_PORT=8001
MCP_METRICS_PORT=9466


# ==============================================================================
# 5) Frontend (Web UI) Configuration
# ==============================================================================
# UI bind address/port (your own app UI, NOT Langfuse)

FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=3000


# ==============================================================================
# 6) LLM Provider Configuration
# ==============================================================================
# Online LLM configuration used by your app.

LLM_API_KEY=CHANGEME_llm_api_key
LLM_SERVER_BASE_URL=https://api.siliconflow.cn/v1
LLM_CHAT_MODEL=Qwen/Qwen3-8B
LLM_EMBEDDING_MODEL=netease-youdao/bce-embedding-base_v1
LLM_EMBEDDING_DIMENSION=768


# ==============================================================================
# 7) Observability / OpenTelemetry (for THIS App)
# ==============================================================================
# Your app and MCP export traces to Alloy via OTLP gRPC in your compose.

# Detect host architecture for correct images (amd64 vs arm64)
ARCH=CHANGEME_architecture

# Grafana credentials for dashboard access
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGEME_grafana_password

# OTLP collector host/port (e.g., grafana/alloy). For compose, "alloy:4317" is common.
# Your docker-compose sets OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4317 in mcp.
MONITORING_HOST=127.0.0.1
MONITORING_PORT=4317


# ==============================================================================
# 8) Langfuse (Trace Store) - OTLP Exporter Side (used by Alloy)
# ==============================================================================
# This section configures Alloy to export traces to Langfuse using OTLP/HTTP.
#
# Network rules:
# - If Alloy runs inside docker-compose, DO NOT use localhost.
# - Use docker service name "langfuse-web" directly.

# Langfuse OTLP HTTP ingestion endpoint
# Format: http(s)://<host>/api/public/otel
# Recommended inside compose: http://langfuse-web:3000/api/public/otel
LANGFUSE_OTLP_ENDPOINT=http://langfuse-web:3000/api/public/otel

# Langfuse OTLP authorization header required by Langfuse ingestion
# Format: Basic base64(public_key:secret_key)
#
# If you FIX keys at init (see section 9), you can compute this before startup:
#   echo -n "pk-...:sk-..." | base64
#   LANGFUSE_OTLP_AUTH_HEADER="Basic <base64-output>"
LANGFUSE_OTLP_AUTH_HEADER="Basic CHANGEME_base64_pk_colon_sk"


# ==============================================================================
# 9) Langfuse Bootstrap (optional, but recommended for non-interactive setup)
# ==============================================================================
# These variables let Langfuse auto-create org/project/user on first startup.
# This is the best way to "pre-fix" pk/sk so OTLP auth header can be known early.
#
# Important:
# - Usually only applies on a fresh Langfuse database (first boot).
# - If you already have Langfuse data, these may not overwrite existing entities.

LANGFUSE_INIT_ORG_ID="my-org"
LANGFUSE_INIT_PROJECT_ID="stock-analysis"
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_PASSWORD=CHANGEME_langfuse_admin_password

# Fixed project keys for OTLP authentication (generate once, keep stable)
# Public key format: pk- + 32 hex chars (16 bytes)
# Generate:
#   echo "pk-$(openssl rand -hex 16)"
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-CHANGEME_32_HEX

# Secret key format: sk- + 64 hex chars (32 bytes)
# Generate:
#   echo "sk-$(openssl rand -hex 32)"
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-CHANGEME_64_HEX


# ==============================================================================
# 10) Langfuse Server Configuration (used by langfuse-web/langfuse-worker)
# ==============================================================================
# These are required to run Langfuse securely and correctly.

# Public URL where the browser accesses Langfuse.
# In this setup, Langfuse is published directly on port 8082.
LANGFUSE_NEXTAUTH_URL=http://localhost:8082

# NextAuth secret: signs/encrypts auth cookies/tokens
# Required. Generate:
#   openssl rand -base64 48
LANGFUSE_NEXTAUTH_SECRET=CHANGEME_nextauth_secret

# Salt used by Langfuse for hashing/derivation (do not rotate casually)
# Required. Generate:
#   openssl rand -hex 16
LANGFUSE_SALT=CHANGEME_salt_hex

# Encryption key for sensitive data at rest (64 hex chars, do not rotate casually)
# Required. Generate:
#   openssl rand -hex 32
LANGFUSE_ENCRYPTION_KEY=CHANGEME_64_hex_encryption_key

# Postgres credentials for Langfuse (separate db/user from your app)
# Your compose includes a langfuse-db-init job that creates these in the existing Postgres.
LANGFUSE_DB_USER=langfuse
LANGFUSE_DB_PASSWORD=CHANGEME_langfuse_db_password
LANGFUSE_DB_NAME=langfuse

# ClickHouse credentials for Langfuse analytics/event store
LANGFUSE_CLICKHOUSE_USER=clickhouse
LANGFUSE_CLICKHOUSE_PASSWORD=CHANGEME_clickhouse_password

# MinIO bucket used by Langfuse for media/events/exports
# Your compose includes a langfuse-minio-init job that creates this bucket.
LANGFUSE_S3_BUCKET=langfuse

# Redis password for Langfuse internal queues/caching
# If your redis has no password, keep empty.
LANGFUSE_REDIS_AUTH=${REDIS_PASSWORD}

# Enable/disable Langfuse telemetry (anonymous usage stats)
LANGFUSE_TELEMETRY_ENABLED=true
